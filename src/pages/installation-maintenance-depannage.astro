---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import UrgenceBox from '../components/UrgenceBox.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import Todo from '../components/Todo.astro';
import hero from '../assets/images/chantier-sechoir.jpg';
---
<BaseLayout
  title="Installation, maintenance et dépannage de silos et séchoirs"
  description="Installation, réglages, mise en route, maintenance préventive et dépannage rapide de silos, séchoirs et manutention de grain. Loiret, Centre-Val de Loire. 02 38 33 51 13."
>
  <PageHero title="Installation, maintenance & dépannage" eyebrow="Service" image={hero}
    imageAlt="Séchoir à grain et cellule de stockage"
    lead="Nos techniciens interviennent efficacement et en toute sécurité, de la mise en route au dépannage." />

  <div class="container-mte -mt-px pt-10 md:pt-14">
    <UrgenceBox />
  </div>

  <section class="section" aria-labelledby="services">
    <div class="container-mte">
      <SectionHeading id="services" eyebrow="Nos interventions" title="Des techniciens réactifs et disponibles" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <ServiceCard icon="hardhat" title="Installation" text="Montage de vos équipements par les techniciens MTE, avec des interventions efficaces et en toute sécurité." />
        <ServiceCard icon="gear" title="Réglages & mise en route" text="Réglage des appareils, essais à vide et en charge, mise en route et prise en main par vos équipes." />
        <ServiceCard icon="calendar" title="Maintenance préventive" text="Visites planifiées sur l’ensemble des matériels : manutention, séchoirs, nettoyage, dépoussiérage, électricité." />
        <ServiceCard icon="wrench" title="Dépannage" text="Intervention dans les meilleurs délais pour remettre votre installation en service, en particulier en pleine campagne." />
      </div>
    </div>
  </section>

  <section class="section bg-steel-50" aria-labelledby="preventif">
    <div class="container-mte grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeading id="preventif" eyebrow="Maintenance préventive" title="Anticiper plutôt que subir la panne" />
        <div class="prose-mte">
          <p>Une installation entretenue tourne mieux et plus longtemps. Avant la moisson ou la campagne maïs, nous contrôlons les points sensibles pour éviter l’arrêt en pleine récolte.</p>
          <p>Contrat de maintenance : <Todo label="formules, fréquence des visites, conditions" /></p>
        </div>
      </div>
      <ul class="grid gap-3 self-center sm:grid-cols-2">
        {['Élévateurs : sangles, godets, paliers', 'Transporteurs : chaînes, racleurs, entraînements', 'Séchoirs : brûleurs, ventilation, sondes', 'Nettoyeurs et calibreurs : grilles, réglages', 'Dépoussiérage : filtres, réseaux', 'Armoires : sécurités, asservissements'].map((t) => (
          <li class="flex items-start gap-3 border border-steel-200 bg-white p-4 font-semibold"><Icon name="check" size={22} class="mt-0.5 shrink-0 text-mte" />{t}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="securite">
    <div class="container-mte flex flex-col gap-6 md:flex-row md:items-center">
      <span class="inline-flex h-20 w-20 shrink-0 items-center justify-center bg-steel-100 text-mte"><Icon name="shield" size={44} /></span>
      <div>
        <h2 id="securite" class="text-3xl">La sécurité avant tout</h2>
        <p class="mt-3 max-w-3xl text-lg text-steel-700">Travail en hauteur, espaces confinés, atmosphères poussiéreuses : nos techniciens appliquent des procédures adaptées aux sites de stockage de grain.
          Habilitations et formations : <Todo label="habilitations et formations des techniciens" /></p>
      </div>
    </div>
  </section>

  <CtaBanner title="Planifier une visite de maintenance" text="Préparez la prochaine campagne : contactez-nous pour un contrôle de votre installation." />
</BaseLayout>
