---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';
---
<BaseLayout title="Message envoyé" description="Votre demande a bien été transmise à MTE." noindex>
  <section class="section">
    <div class="container-mte max-w-2xl text-center">
      <span class="mx-auto mb-6 inline-flex h-20 w-20 items-center justify-center bg-mte text-white"><Icon name="check" size={44} /></span>
      <h1 class="text-4xl sm:text-5xl">Merci, votre demande est envoyée</h1>
      <p class="mt-4 text-lg text-steel-700">Nous revenons vers vous rapidement. En cas d’urgence, appelez-nous directement au <a href={SITE.phoneHref} class="font-semibold text-mte-dark underline">{SITE.phone}</a>.</p>
      <a href="/" class="btn-dark mt-8">Retour à l’accueil</a>
    </div>
  </section>
</BaseLayout>
