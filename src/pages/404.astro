---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---
<BaseLayout title="Page introuvable" description="Cette page n’existe pas ou a été déplacée." noindex>
  <section class="section">
    <div class="container-mte max-w-2xl text-center">
      <p class="font-display text-8xl font-bold text-mte">404</p>
      <h1 class="mt-2 text-4xl">Page introuvable</h1>
      <p class="mt-4 text-lg text-steel-700">Cette page n’existe pas ou a été déplacée.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Retour à l’accueil</a>
        <a href={SITE.phoneHref} class="btn-outline">Appeler le {SITE.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>
