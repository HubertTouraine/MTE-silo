---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Gallery from '../components/Gallery.astro';
import Icon from '../components/Icon.astro';
import Todo from '../components/Todo.astro';
import { SITE } from '../config';
import { SECTEURS } from '../data/secteurs';
import hero from '../assets/images/silos-orage.jpg';
import atelier from '../assets/images/chantier-tour-manutention.jpg';

const realisations = (await getCollection('realisations', (r) => !r.data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const metiers = [
  { title: 'Ingénierie & projets', icon: 'diagram', href: '/ingenierie-projets/',
    text: 'Du cahier des charges aux plans, nous concevons votre installation sur mesure et coordonnons le chantier jusqu’à la mise en route.' },
  { title: 'Fournitures', icon: 'elevator', href: '/fournitures/',
    text: 'Manutention, séchoirs, nettoyage et calibrage, dépoussiérage, boisseaux, armoires électriques : le bon matériel pour votre site.' },
  { title: 'Atelier métallerie-chaudronnerie', icon: 'hammer', href: '/atelier-metallerie-chaudronnerie/',
    text: 'Notre atelier intégré fabrique accès, passerelles, fosses, charpentes et pièces sur mesure.' },
  { title: 'Maintenance & dépannage', icon: 'wrench', href: '/installation-maintenance-depannage/',
    text: 'Installation, réglages, maintenance préventive et dépannage rapide de vos équipements de stockage.' },
] as const;
---
<BaseLayout
  title="MTE – Créateur de silos à grain dans le Loiret | Installation, séchoirs, manutention"
  description="MTE, créateur de silos à Puiseaux (Loiret) : conception, fabrication, installation et maintenance de silos à grain, séchoirs et manutention sur mesure en Centre-Val de Loire."
>
  <!-- HERO -->
  <section class="relative isolate flex min-h-[calc(100svh-4.25rem)] items-end overflow-hidden bg-steel-950 text-white lg:min-h-[calc(100svh-5.25rem)]">
    <Image src={hero} alt="Silos à grain en tôle galvanisée et passerelle de manutention réalisés par MTE, sous un ciel d’orage"
      widths={[640, 960, 1280, 1600, 2000, 2400]} sizes="100vw" loading="eager" fetchpriority="high"
      class="absolute inset-0 -z-10 h-full w-full object-cover" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-steel-950 via-steel-950/70 to-steel-950/10" aria-hidden="true"></div>
    <div class="container-mte pb-28 pt-32 md:pb-24">
      <p class="eyebrow !text-white">MTE · Puiseaux, Loiret</p>
      <h1 class="max-w-4xl text-5xl !text-white sm:text-6xl lg:text-8xl">Créateur de silos</h1>
      <p class="mt-6 max-w-2xl text-lg text-steel-100 sm:text-xl">
        Conception, fabrication, installation et maintenance d’installations de stockage de grain sur mesure,
        pour les organismes stockeurs, les agriculteurs et l’agro-industrie.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/contact/" class="btn-primary">Demander un devis <Icon name="arrow" size={20} /></a>
        <a href={SITE.phoneHref} class="btn-outline-light"><Icon name="phone" size={20} />Dépannage : {SITE.phone}</a>
      </div>
    </div>
  </section>

  <!-- CHIFFRES / ATOUTS -->
  <section class="border-b border-steel-200 bg-steel-50" aria-label="Nos points forts">
    <ul class="container-mte grid grid-cols-2 lg:grid-cols-4">
      {[
        ['diagram', 'Études sur mesure', 'Cahier des charges, diagrammes, plans'],
        ['hammer', 'Atelier intégré', 'Métallerie et chaudronnerie'],
        ['hardhat', 'Équipes de pose', 'Installation et mise en route'],
        ['wrench', 'Maintenance', 'Préventive et dépannage'],
      ].map(([icon, t, s]) => (
        <li class="flex items-start gap-3 py-6 pr-2 sm:px-4">
          <Icon name={icon as any} size={28} class="shrink-0 text-mte" />
          <div><p class="font-display text-lg font-bold uppercase leading-tight text-steel-950">{t}</p><p class="text-sm text-steel-700">{s}</p></div>
        </li>
      ))}
    </ul>
  </section>

  <!-- MÉTIERS -->
  <section class="section" aria-labelledby="metiers">
    <div class="container-mte">
      <SectionHeading id="metiers" eyebrow="Nos métiers" title="Un seul interlocuteur, de l’étude à la maintenance"
        lead="MTE conçoit et installe des équipements agricoles et agro-industriels. Nos équipes maîtrisent chaque étape de votre projet de stockage." />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {metiers.map((m, i) => <ServiceCard {...m} index={String(i + 1).padStart(2, '0')} />)}
      </div>
    </div>
  </section>

  <!-- ATELIER / SAVOIR-FAIRE -->
  <section class="section bg-steel-950 text-white" aria-labelledby="savoir-faire">
    <div class="container-mte grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="relative">
        <Image src={atelier} alt="Tour de manutention en cours de montage par les techniciens MTE" widths={[480, 800, 1100]}
          sizes="(min-width:1024px) 50vw, 100vw" class="aspect-[4/5] w-full object-cover lg:aspect-[4/4]" loading="lazy" />
        <div class="absolute -bottom-4 -right-4 hidden h-24 w-24 bg-mte lg:block" aria-hidden="true"></div>
      </div>
      <div>
        <p class="eyebrow !text-white">Savoir-faire</p>
        <h2 id="savoir-faire" class="text-3xl !text-white sm:text-4xl lg:text-5xl">Des installations pensées pour durer</h2>
        <p class="mt-5 text-lg text-steel-200">
          Silos à grain, séchoirs, manutention, nettoyage, dépoussiérage : chaque installation est dimensionnée selon vos volumes,
          vos débits et la configuration de votre site. Notre atelier fabrique les pièces et structures qui n’existent pas sur catalogue.
        </p>
        <ul class="mt-6 space-y-3">
          {['Solutions techniques adaptées et chiffrées', 'Coordination de tous les intervenants du chantier', 'Interventions en toute sécurité', 'Réactivité en période de récolte'].map((t) => (
            <li class="flex items-start gap-3"><Icon name="check" size={22} class="mt-0.5 shrink-0 text-mte-50" /><span>{t}</span></li>
          ))}
        </ul>
        <p class="mt-6 text-steel-200">Années d’expérience : <Todo label="année de création / expérience" /> · Silos installés : <Todo label="nombre de réalisations" /></p>
      </div>
    </div>
  </section>

  <!-- POUR QUI -->
  <section class="section" aria-labelledby="pour-qui">
    <div class="container-mte">
      <SectionHeading id="pour-qui" eyebrow="Ils nous font confiance" title="Pour qui travaillons-nous ?"
        lead="Du silo de ferme au site de collecte, MTE accompagne tous les métiers du grain." />
      <ul class="grid grid-cols-2 gap-px border border-steel-200 bg-steel-200 md:grid-cols-3 lg:grid-cols-6">
        {SECTEURS.map((s) => (
          <li class="flex flex-col items-center gap-3 bg-white px-3 py-8 text-center">
            <Icon name={s.icon} size={36} class="text-mte" />
            <span class="font-display text-lg font-semibold uppercase leading-tight text-steel-950">{s.title}</span>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-steel-700">Références clients : <Todo label="noms ou logos de clients, avec leur accord" /></p>
      <a href="/clients/" class="btn-outline mt-6">Nos clients et secteurs <Icon name="arrow" size={20} /></a>
    </div>
  </section>

  <!-- RÉALISATIONS -->
  <section class="section bg-steel-50" aria-labelledby="apercu-realisations">
    <div class="container-mte">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHeading id="apercu-realisations" eyebrow="Réalisations" title="Nos derniers chantiers" />
        <a href="/realisations/" class="btn-dark mb-10 self-start md:mb-14 md:self-auto">Toutes les réalisations <Icon name="arrow" size={20} /></a>
      </div>
      <Gallery items={realisations} filters={false} headingLevel="h3" />
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
