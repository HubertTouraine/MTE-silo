---
import { SITE } from '../config';
import Icon from './Icon.astro';
interface Props { title?: string; text?: string }
const {
  title = 'Un projet de stockage ou une installation à moderniser ?',
  text = 'Parlons de votre besoin : capacité, débit, séchage, nettoyage, sécurité. Nous vous répondons avec une solution chiffrée.',
} = Astro.props;
---
<section class="relative isolate overflow-hidden bg-mte text-white" aria-labelledby="cta-titre">
  <div class="bg-corrugated absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-mte flex flex-col gap-8 py-14 md:py-16 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-2xl">
      <h2 id="cta-titre" class="text-3xl !text-white sm:text-4xl">{title}</h2>
      <p class="mt-3 text-lg text-white">{text}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href="/contact/" class="btn bg-white text-steel-950 hover:bg-steel-100">Demander un devis <Icon name="arrow" size={20} /></a>
      <a href={SITE.phoneHref} class="btn-outline-light" aria-label={`Appeler MTE au ${SITE.phone}`}><Icon name="phone" size={20} />{SITE.phone}</a>
    </div>
  </div>
</section>
