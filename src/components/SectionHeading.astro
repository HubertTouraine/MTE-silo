---
interface Props { eyebrow?: string; title: string; lead?: string; center?: boolean; id?: string; light?: boolean }
const { eyebrow, title, lead, center = false, id, light = false } = Astro.props;
---
<div class:list={['mb-10 max-w-3xl md:mb-14', center && 'mx-auto text-center']}>
  {eyebrow && <p class:list={['eyebrow', light && '!text-white']}>{eyebrow}</p>}
  <h2 id={id} class:list={['text-3xl sm:text-4xl lg:text-5xl', light && '!text-white']}>{title}</h2>
  {lead && <p class:list={['mt-4 text-lg', light ? 'text-steel-200' : 'text-steel-700']}>{lead}</p>}
</div>
