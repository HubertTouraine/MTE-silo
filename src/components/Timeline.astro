---
import Icon from './Icon.astro';
interface Step { title: string; text: string; icon: Parameters<typeof Icon>[0]['name'] }
interface Props { steps: Step[] }
const { steps } = Astro.props;
---
<ol class="relative grid gap-8 before:absolute before:bottom-0 before:left-7 before:top-0 before:w-0.5 before:bg-steel-200 before:content-[''] lg:grid-cols-5 lg:gap-4 lg:before:bottom-auto lg:before:left-0 lg:before:right-0 lg:before:top-7 lg:before:h-0.5 lg:before:w-auto">
  {steps.map((s, i) => (
    <li class="relative flex gap-5 lg:flex-col lg:gap-4">
      <span class="relative z-10 inline-flex h-14 w-14 shrink-0 items-center justify-center bg-mte text-white ring-8 ring-white">
        <Icon name={s.icon} size={28} />
      </span>
      <div>
        <p class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-mte-dark">Étape {i + 1}</p>
        <h3 class="mt-1 text-2xl">{s.title}</h3>
        <p class="mt-2 text-steel-700">{s.text}</p>
      </div>
    </li>
  ))}
</ol>
