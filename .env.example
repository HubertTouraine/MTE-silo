# Formulaire de contact
# netlify  : Netlify Forms (aucun réglage, fonctionne uniquement une fois déployé sur Netlify)
# formspree: renseigner PUBLIC_FORM_ENDPOINT avec l'URL fournie par Formspree (ex. https://formspree.io/f/abcdwxyz)
PUBLIC_FORM_PROVIDER=netlify
PUBLIC_FORM_ENDPOINT=

# URL de production (sitemap, balises canonical, Open Graph)
SITE_URL=https://www.mte-silo.com
